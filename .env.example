# Название группы на сайте ДГТУ. Поиск найдёт её текущий числовой ID.
GROUP_NAME=ВКБ51
GROUP_ID=72244

# Московское время (UTC+3). Если время не задано, используется 08:00.
DAILY_TIME=08:00
# Формат недели для новых подписчиков: horizontal, vertical или list.
WEEK_LAYOUT=horizontal
# Осенняя тема для дат сентября–ноября; false оставляет классическую палитру.
SEASONAL_THEME=true
CHECK_INTERVAL_SECONDS=300

# Укажите один из адресов ниже. Для прокси со скриншота используйте HTTP-порт
# в TELEGRAM_PROXY_URL: http://ЛОГИН:ПАРОЛЬ@АДРЕС:ПОРТ_HTTP
# Альтернатива — SOCKS5-порт: socks5h://ЛОГИН:ПАРОЛЬ@АДРЕС:ПОРТ_SOCKS5
# TELEGRAM_PROXY_URL=
# Общая настройка для всех сервисов:
# PROXY_URL=
# Отдельные настройки для API ДГТУ и ВКонтакте:
# DONSTU_PROXY_URL=
# VK_PROXY_URL=

# Telegram: создайте бота в @BotFather и вставьте токен.
# public — любой открывший ссылку на бота может выбрать свою группу и подключиться.
# code — подключение только по /start ВАШ_КОД.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ACCESS=public
# Требуется только для TELEGRAM_ACCESS=code:
TELEGRAM_PAIR_CODE=
# Разрешить нескольким личным чатам подключаться. Настройки у каждого свои.
ALLOW_MULTIPLE_USERS=true
# Можно указать ID чата напрямую вместо кода сопряжения:
# TELEGRAM_CHAT_ID=

# ВКонтакте: токен сообщества с правом отправки сообщений и ваш числовой ID.
VK_COMMUNITY_TOKEN=
VK_PEER_ID=
# Виды уведомлений ВК через запятую; all — все, none — отключить оповещения.
# VK_ALERT_TYPES=added,removed,time,room,teacher,subject,subgroup,replacement,other

# По умолчанию состояние сохраняется в data/state.json.
# STATE_FILE=data/state.json
